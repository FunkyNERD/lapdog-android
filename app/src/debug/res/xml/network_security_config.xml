<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain http to a local website through adb reverse, for testing timer
     updates against a dev copy of lapdog-web (TimerFirmware.setBase). Release builds keep the
     default: https only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
